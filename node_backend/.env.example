PORT=3000
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CALLYZER_API_KEY=your_callyzer_api_key
LSQ_API_HOST=https://api-in21.leadsquared.com/v2
LSQ_ACCESS_KEY=your_lsq_access_key
LSQ_SECRET_KEY=your_lsq_secret_key
LSQ_QC_ACTIVITY_EVENT_CODE=279


# asr_backend/.env: shared secret the Meet webhook caller sends as X-Webhook-Secret
# MEET_WEBHOOK_SECRET=

# Parallel Range parts for Google Drive demo downloads (1 = single stream)
DRIVE_DOWNLOAD_PARTS=4

# Read-only key shipped in the frontend bundle (GET only). Must equal VITE_VIEWER_TOKEN in frontend/.env
VIEWER_SECRET=
