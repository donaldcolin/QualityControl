{
  "file": "b823aee7-7448-11f1-bd10-0a70299d455d.mp3",
  "language": "ta",
  "speaker_turns": [
    {
      "start": 0.03096875,
      "end": 1.41471875,
      "speaker": "SPEAKER_00",
      "text": "ஹலோ சார் ஹலோ"
    },
    {
      "start": 2.15721875,
      "end": 2.83221875,
      "speaker": "SPEAKER_02",
      "text": "ஆஹ் சார்"
    },
    {
      "start": 2.17409375,
      "end": 4.047218750000001,
      "speaker": "SPEAKER_00",
      "text": "ஆஹ் ச ஆ சொல்லுங்க குரு கார்த்தி"
    },
    {
      "start": 4.6040937500000005,
      "end": 7.658468750000001,
      "speaker": "SPEAKER_02",
      "text": "ஆஹ் சார் என் ஃப்ரெண்டு ஒருத்தனம் இந்தந்த கல்ும் செய்ேணும்னு சொல்லிிருந்தா"
    },
    {
      "start": 7.844093750000001,
      "end": 8.46846875,
      "speaker": "SPEAKER_00",
      "text": "ஓகே"
    },
    {
      "start": 8.974718750000001,
      "end": 12.09659375,
      "speaker": "SPEAKER_02",
      "text": "அவன் நம்பர் அப்படியே உனகிட்ட சொல்றேன் அவன்்ட அபடியே போன் பண்ணிசிக்கிறீங்களா"
    },
    {
      "start": 9.160343750000003,
      "end": 9.447218750000001,
      "speaker": "SPEAKER_00",
      "text": "ஆ"
    },
    {
      "start": 10.594718750000002,
      "end": 10.98284375,
      "speaker": "SPEAKER_00",
      "text": "அவடி"
    },
    {
      "start": 12.19784375,
      "end": 12.906593750000003,
      "speaker": "SPEAKER_00",
      "text": "அப்படிங்களா"
    },
    {
      "start": 13.176593750000002,
      "end": 16.85534375,
      "speaker": "SPEAKER_00",
      "text": "ஆ நீங்க இன்பமேஷன் எாம்டுத்துட்டீங்களா ப்ராசஸ் எப்ப இருக்கும் எல்லா்ராஸும் கொடு"
    },
    {
      "start": 16.34909375,
      "end": 22.035968750000002,
      "speaker": "SPEAKER_02",
      "text": "ஆ அவன்ிட்ட சொல்லிட்டேன் சார் அதான் முதல்ல அட்மிஷன் பண்ணும் அப்புறம் எக்ஸாமு கே என்ட் எக்ஸாமு சைக்கோமெடரிக் டெஸ்ட்"
    },
    {
      "start": 22.035968750000002,
      "end": 23.453468750000003,
      "speaker": "SPEAKER_01",
      "text": "ம்ம்ம் இர்"
    },
    {
      "start": 23.11596875,
      "end": 24.398468750000003,
      "speaker": "SPEAKER_02",
      "text": "இன்ர்வூ எல்லாமே சொல்லேன் சார்"
    },
    {
      "start": 26.254718750000002,
      "end": 28.22909375,
      "speaker": "SPEAKER_01",
      "text": "ஒரே நமிம்ங்க ஒரேிமிம் லைலயிட் புங்க"
    },
    {
      "start": 28.92096875,
      "end": 29.69721875,
      "speaker": "SPEAKER_02",
      "text": "ஆ ஓகே சார்"
    },
    {
      "start": 35.78909375,
      "end": 41.070968750000006,
      "speaker": "SPEAKER_01",
      "text": "ஓகே ஆ நான் வந்து அவங்ககிட்டையும் பேசுகிறேன் நீங்களும் வந்து பார்த்தீங்கன்னா எக்ஸாம் கிளியர் பண்ணுறதுக்கு அவங்களுக்கும் கொஞ்சம் ஹெல்ப் பண்ணுங்க"
    },
    {
      "start": 41.52659375,
      "end": 41.96534375,
      "speaker": "SPEAKER_01",
      "text": "சரி"
    },
    {
      "start": 41.64471875,
      "end": 44.580968750000004,
      "speaker": "SPEAKER_02",
      "text": "ஆஹ சரி ஓகே சார் அது பிரச்சனை இ சார் அவன் நீட் ஸ்டூடெண்ட் தான்"
    },
    {
      "start": 43.02846875,
      "end": 44.19284375,
      "speaker": "SPEAKER_01",
      "text": "சார் நீட்ஸூடண்ட்"
    },
    {
      "start": 44.580968750000004,
      "end": 45.289718750000006,
      "speaker": "SPEAKER_01",
      "text": "அப்படிங்களா"
    },
    {
      "start": 45.205343750000004,
      "end": 46.01534375,
      "speaker": "SPEAKER_02",
      "text": "அதனா எழுதிடுவோம்"
    },
    {
      "start": 46.049093750000004,
      "end": 46.74096875,
      "speaker": "SPEAKER_02",
      "text": "சம்"
    },
    {
      "start": 46.18409375,
      "end": 47.820968750000006,
      "speaker": "SPEAKER_01",
      "text": "ஸ்டூடெண்ட் நேம் என்னப்பா"
    },
    {
      "start": 50.20034375,
      "end": 50.790968750000005,
      "speaker": "SPEAKER_01",
      "text": "ஒரு நேம் என்ண்ணா"
    },
    {
      "start": 54.85784375,
      "end": 55.34721875,
      "speaker": "SPEAKER_01",
      "text": "ஹலோ"
    },
    {
      "start": 58.65471875,
      "end": 59.14409375,
      "speaker": "SPEAKER_01",
      "text": "ஹலோ"
    }
  ]
