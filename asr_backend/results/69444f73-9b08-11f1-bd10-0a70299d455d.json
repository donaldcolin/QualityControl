      "speaker": "SPEAKER_00",
      "text": "லைக் சந்து"
    },
    {
      "start": 7.92846875,
      "end": 8.316593750000003,
      "speaker": "SPEAKER_00",
      "text": "சொல்லுங்கள்"
    },
    {
      "start": 8.56971875,
      "end": 10.98284375,
      "speaker": "SPEAKER_00",
      "text": "செந்துவங்களா நான் கல்வலந்து கால் பண்ணியிருக்கேன்"
    },
    {
      "start": 12.282218750000002,
      "end": 13.716593750000001,
      "speaker": "SPEAKER_00",
      "text": "எங்கங்க கல்வியம்"
    },
    {
      "start": 14.982218750000001,
      "end": 16.180343750000002,
      "speaker": "SPEAKER_00",
      "text": "கல்விியம் யா"
    },
    {
      "start": 17.294093750000002,
      "end": 17.85096875,
      "speaker": "SPEAKER_00",
      "text": "ஓகே"
    },
    {
      "start": 18.188468750000002,
      "end": 18.20534375,
      "speaker": "SPEAKER_00",
      "text": ""
    },
    {
      "start": 18.20534375,
      "end": 22.86284375,
      "speaker": "SPEAKER_01",
      "text": "ஒரு எனன்கொயரி வந்தது ரெக்கார்டி் பிடெக் சிஎஸஇ இன்ஜினியரிங் டிார்ட்மெண்ட் ரிலேட்டுட்"
    },
    {
      "start": 18.27284375,
      "end": 18.69471875,
      "speaker": "SPEAKER_00",
      "text": "என் பயும்"
    },
    {
      "start": 24.465968750000002,
      "end": 25.07346875,
      "speaker": "SPEAKER_01",
      "text": "ஓகேங்க"
    },
    {
      "start": 25.191593750000003,
      "end": 29.309093750000002,
      "speaker": "SPEAKER_01",
      "text": "ய ஸ்டூடண்டட இப்ப கண்டா டுவல்து படிச்சட்டு இருக்காங்களா இல்ல கம்ப்ளீட் பண்ணிட்டாங்களா மேம்"
    },
    {
      "start": 29.44409375,
      "end": 30.74346875,
      "speaker": "SPEAKER_01",
      "text": "இல்ல இப்போ கரண்ட் வல்த மேம்"
    },
    {
      "start": 30.996593750000002,
      "end": 33.915968750000005,
      "speaker": "SPEAKER_01",
      "text": "ஓகே ஓகே ஓகே லைக் அவங்க தான் அதை பத்தி பாத்துருக்காங்க"
    },
    {
      "start": 34.37159375,
      "end": 36.43034375,
      "speaker": "SPEAKER_01",
      "text": "ஆ ஓகே ஓகே அத"
    },
    {
      "start": 35.13096875,
      "end": 36.19409375,
      "speaker": "SPEAKER_00",
      "text": "அ நீ அதி ந"
    },
    {
      "start": 36.93659375,
      "end": 41.391593750000006,
      "speaker": "SPEAKER_01",
      "text": "ஓகே ஓகே ஓகே மேம் லைக் ஸ்டடெண்ட்ட டுவெல்த்தில் போய் என்ன மேம் கு்ரூப் எடுத்து படிக்கிறாங்க"
    },
    {
      "start": 41.94846875,
      "end": 46.656593750000006,
      "speaker": "SPEAKER_01",
      "text": "ஆ மேக்ஸ் கம்யூட்டர் சயின்ஸ் மேம்யூட்டர் சயின்ஸ்ஓகே இப்போஃப்ரீாக்கீங்களா பேசலா இல்ல பிியா இருக்கீா மேம்"
    },
    {
      "start": 44.39534375,
      "end": 45.07034375,
      "speaker": "SPEAKER_00",
      "text": "ஃரீா இருக்கங்களா"
    },
    {
      "start": 46.84221875,
      "end": 52.95096875,
      "speaker": "SPEAKER_01",
      "text": "இல்ல மேம் இப்பதான் உ டியூஷன் கூறதான் கிளம்பிட்டு இருக்கேன்கே நீங்கீங்களே"
    },
    {
      "start": 52.95096875,
      "end": 54.469718750000006,
      "speaker": "SPEAKER_00",
      "text": "ஓகே சரிங்கமா தேங்க்யூ தேங்க்யூ"
    },
    {
      "start": 56.275343750000005,
      "end": 56.61284375,
      "speaker": "SPEAKER_00",
      "text": "ம்"
    },
    {
      "start": 58.587218750000005,
      "end": 59.025968750000004,
      "speaker": "SPEAKER_00",
      "text": "ரி"
    },
    {
      "start": 60.03846875000001,
      "end": 60.74721875,
      "speaker": "SPEAKER_00",
      "text": "வரரைகம்லாம்"
    }
  ]
