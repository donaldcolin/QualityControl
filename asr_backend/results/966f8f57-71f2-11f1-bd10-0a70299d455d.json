  "speaker_turns": [
    {
      "start": 0.11534375000000001,
      "end": 1.0265937500000002,
      "speaker": "SPEAKER_00",
      "text": "ஹலோ ஹலோ"
    },
    {
      "start": 2.0897187500000003,
      "end": 2.84909375,
      "speaker": "SPEAKER_01",
      "text": "யார் பேசது"
    },
    {
      "start": 3.1359687500000004,
      "end": 4.6040937500000005,
      "speaker": "SPEAKER_00",
      "text": "ஆ குருகத்திக்கு தான் பேசுறீங்களா"
    },
    {
      "start": 5.262218750000001,
      "end": 5.90346875,
      "speaker": "SPEAKER_00",
      "text": "ஆ ஆமாம் சார்"
    },
    {
      "start": 6.13971875,
      "end": 7.945343750000001,
      "speaker": "SPEAKER_00",
      "text": "நான் கல்வியில இருந்து அப்துல் பேசுறேன்ப்பா"
    },
    {
      "start": 8.063468750000002,
      "end": 8.94096875,
      "speaker": "SPEAKER_01",
      "text": "ஆ சொல்லுங்க சார்"
    },
    {
      "start": 9.059093750000002,
      "end": 10.88159375,
      "speaker": "SPEAKER_00",
      "text": "ஆக்சுவா நம்ப சேவ் பண்ணலல்லாம் நீங்க"
    },
    {
      "start": 11.927843750000001,
      "end": 15.488468750000003,
      "speaker": "SPEAKER_01",
      "text": "என்ன இல்ல சார் நான் சேவ் பண்ணிருக்கன் போன் வாாக்ல இருந்தது அதனால காமிக்காது சார்"
    },
    {
      "start": 15.57284375,
      "end": 17.10846875,
      "speaker": "SPEAKER_00",
      "text": "ஓ ஓகே ஓகே ஓகே ஓகே"
    },
    {
      "start": 17.41221875,
      "end": 20.41596875,
      "speaker": "SPEAKER_00",
      "text": "ஆ ரீச் ஆயிட்டங்களா இன்ர்வியூல்லாம் முடிஞ்சதாேம தான் போயிட்டு இருக்கீா"
    },
    {
      "start": 21.07409375,
      "end": 22.508468750000002,
      "speaker": "SPEAKER_01",
      "text": "ஆ உள்ளதான் சார் இருக்கேன் சொண்ணும்"
    },
    {
      "start": 22.64346875,
      "end": 23.824718750000002,
      "speaker": "SPEAKER_00",
      "text": "இதுவி முஞா நிமிதானான்"
    },
    {
      "start": 25.140968750000003,
      "end": 25.74846875,
      "speaker": "SPEAKER_01",
      "text": "ஹலோ சார்"
    },
    {
      "start": 25.74846875,
      "end": 27.13221875,
      "speaker": "SPEAKER_00",
      "text": "இன்ர்வியூ முஞ்சதானமதானா"
    },
    {
      "start": 27.351593750000003,
      "end": 30.96284375,
      "speaker": "SPEAKER_01",
      "text": "இல்ல சார் இன்ர்ியூ இும் முடியல ச ஸ்டூடண்ட் செஷன் மாதி ஒும் முடிச்சம் சார் அவவளோான் சார்"
    },
    {
      "start": 30.96284375,
      "end": 33.24096875,
      "speaker": "SPEAKER_00",
      "text": "கு ஸ்டேஷன் முடிச்சிருக்கங்களா சரி ஓகே"
    },
    {
      "start": 32.751593750000005,
      "end": 33.35909375,
      "speaker": "SPEAKER_01",
      "text": "ஆமாாம் சார்"
    },
    {
      "start": 33.25784375,
      "end": 33.274718750000005,
      "speaker": "SPEAKER_00",
      "text": ""
    },
    {
      "start": 33.35909375,
      "end": 36.90284375,
      "speaker": "SPEAKER_00",
      "text": "ஓகேப்பா யார் கூடயிருக்கீங்க அம்மா கூடீங்களா இல்லலை சத்தப்பாப்ப யருய மாய இருிருங்க"
    },
    {
      "start": 38.11784375,
      "end": 40.564718750000004,
      "speaker": "SPEAKER_01",
      "text": "அம்மா கூடையும் மாமா தான் வந்திருக்காங்க"
    },
    {
      "start": 39.53534375,
      "end": 39.704093750000006,
      "speaker": "SPEAKER_00",
      "text": "ஆமா"
    },
    {
      "start": 40.564718750000004,
      "end": 43.63596875,
      "speaker": "SPEAKER_00",
      "text": "ஓகே ஓகே ச ச ஓகேப்பா ஓகே ஓகே ஓகே அத"
    },
    {
      "start": 41.205968750000004,
      "end": 42.20159375,
      "speaker": "SPEAKER_01",
      "text": "அலிர இருக்கும் சார்"
    },
    {
      "start": 43.90596875,
      "end": 47.500343750000006,
      "speaker": "SPEAKER_00",
      "text": "அதாவ ரீ ஆிக்குங்களாலன்ச்லாம் கொடுருவங்கரிங்களா மன்ஷன் பண்ணிருப்பாங்க நினைிறேன் ஆல்ரடி"
    },
    {
      "start": 48.63096875,
      "end": 53.642843750000004,
      "speaker": "SPEAKER_01",
      "text": "ஆ ஓகே ச ஆமா சார் அந்த இது இ டீடெயல் ஸ்ிப் போ ஃபார்ம்ும் நம்ச்ச சொல்லட்டுருந்தாங்க அதுல இருது சார் பிடிஎப்ல"
    },
    {
      "start": 53.642843750000004,
      "end": 56.86596875,
      "speaker": "SPEAKER_00",
      "text": "ஓகே சரி ஓகேப்பா ஓகே கு்கா்த்தி கே"
    },
    {
      "start": 56.71409375,
      "end": 57.38909375,
      "speaker": "SPEAKER_01",
      "text": "ஆ ஓகே சார்"
    },
    {
      "start": 57.38909375,
      "end": 58.890968750000006,
      "speaker": "SPEAKER_00",
      "text": "ஓகே நல்லாண்ணங்க சரிங்களா தேங்க்யூ"
    },
    {
      "start": 59.009093750000005,
      "end": 59.329718750000005,
      "speaker": "SPEAKER_01",
      "text": "ஆ"
    },
    {
      "start": 59.56596875,
      "end": 60.679718750000006,
      "speaker": "SPEAKER_00",
