      "text": ""
    },
    {
      "start": 3.79409375,
      "end": 4.283468750000001,
      "speaker": "Customer",
      "text": "ஹ"
    },
    {
      "start": 5.127218750000001,
      "end": 7.21971875,
      "speaker": "Customer",
      "text": "ஹலோ அ ஷண்மிதாானயா"
    },
    {
      "start": 8.02971875,
      "end": 14.070968750000002,
      "speaker": "Customer",
      "text": "இல்லலை நான் சவிீதாவோட சிகஸ்டர் பேசுறேன் சொல்லுமா யா ஓகே நான் கல்வியம்ல இருந்து கால் பண்ணியிருக்கேன்ப்பா"
    },
    {
      "start": 14.712218750000002,
      "end": 21.96846875,
      "speaker": "Customer",
      "text": "ஆஹ் சொல்லுங்க மேம் ஒரு என்கவயரி வந்துஷண்மிதாலைக்கு ரிகார்டிங் கேனட் அப்படிங்கற என்ண்ட்ரன்ஸ் எக்ஸாம்கக்காக பாத்துிருக்கீங்கன்னா கால் பண்ணிருந்தேன்"
    },
    {
      "start": 15.79221875,
      "end": 16.011593750000003,
      "speaker": "Agent",
      "text": "ஆர்"
    },
    {
      "start": 22.49159375,
      "end": 22.660343750000003,
      "speaker": "Agent",
      "text": ""
    },
    {
      "start": 23.774093750000002,
      "end": 27.03096875,
      "speaker": "Agent",
      "text": "அப்பியா அவங்க இப்போ வெளியே போயிருக்காங்க ந வேணா"
    },
    {
      "start": 27.03096875,
      "end": 31.35096875,
      "speaker": "Customer",
      "text": "வந்த கால் பண்ணமா சரிப்ப இப்போ"
    },
    {
      "start": 32.19471875,
      "end": 34.21971875,
      "speaker": "Customer",
      "text": "ஸ்டடெண்ட் வந்து டுவெ்த் படிச்சிட்டு இருக்காங்களா"
    },
    {
      "start": 34.979093750000004,
      "end": 35.02971875,
      "speaker": "Agent",
      "text": ""
    },
    {
      "start": 35.02971875,
      "end": 35.06346875,
      "speaker": "Customer",
      "text": ""
    },
    {
      "start": 35.06346875,
      "end": 36.78471875,
      "speaker": "Agent",
      "text": "உங்கள் காலேஜே முடிக்க போகிறாங்க"
    },
    {
      "start": 36.78471875,
      "end": 38.32034375,
      "speaker": "Customer",
      "text": "ஓகே டுவல்த்டிிற ஸ்டூடண்ட்"
    },
    {
      "start": 39.78846875,
      "end": 39.97409375,
      "speaker": "Customer",
      "text": "ஆ"
    },
    {
      "start": 39.97409375,
      "end": 40.42971875,
      "speaker": "Agent",
      "text": "ப"
    },
    {
      "start": 40.42971875,
      "end": 41.32409375,
      "speaker": "Customer",
      "text": "கிரஸ்டூந்து"
    },
    {
      "start": 41.32409375,
      "end": 41.391593750000006,
      "speaker": "Agent",
      "text": ""
    },
    {
      "start": 41.391593750000006,
      "end": 41.45909375,
      "speaker": "Customer",
      "text": ""
    },
    {
      "start": 41.45909375,
      "end": 42.31971875,
      "speaker": "Agent",
      "text": "கம்பி தான் இருக்காங்க"
    },
    {
      "start": 42.69096875,
      "end": 48.51284375,
      "speaker": "Customer",
      "text": "ஓகே அதாவது டுவெல்த இப்ப கரண்டாக படிச்சுட்டுருக்க ஸ்டடெண்ட்டுக்கான என்ட்ரன்ஸ் எக்ஸாம்காக தான்ார்த்துக்கா அதான் கால் பண்ணிருந்தேன்"
    },
    {
      "start": 48.81659375,
      "end": 50.30159375,
      "speaker": "Agent",
      "text": "சரி ஓகே"
    },
    {
      "start": 51.04409375,
      "end": 54.60471875,
      "speaker": "Customer",
      "text": "லைக் தம்பி என்ன குரூப் எடுத்து படிக்கிறாங்க"
    },
    {
      "start": 55.76909375,
      "end": 57.15284375,
      "speaker": "Agent",
      "text": "கம்ப்யூட்ரு சயின்ஸ் படிக்கலாம்"
    },
    {
      "start": 57.15284375,
      "end": 63.565343750000004,
      "speaker": "Customer",
      "text": "ஓகே ஓகே அது கம்யூட்டர் சயின்ஸ் இன்ஜினியரிங் டிபார்ட்மெண்ட்கான என்ட்ரன்ஸ் எக்ஸாம் பத்திதான் பாத்துிருக்கங்க பட் யார்ேம்லன்னு தெரியல"
    },
    {
      "start": 64.30784375,
      "end": 68.13846875,
      "speaker": "Customer",
      "text": "காமனா ஒரு நேம்முங்கது போட்டிருக்காங்க கம்யூட்டர் சயஸ் குரூப் எடுத்து படிக்கிறாங்களா"
    },
    {
      "start": 69.65721875,
      "end": 71.10846875,
      "speaker": "Agent",
      "text": "ஆ இல்லை மேம்"
    },
    {
      "start": 71.15909375000001,
      "end": 72.59346875,
      "speaker": "Agent",
      "text": "நான் வேணா"
    },
    {
      "start": 72.89721875000001,
      "end": 74.53409375000001,
      "speaker": "Agent",
      "text": "அப்புறமேட்டு உங்களுக்கு கால் பண்ணட்டமா"
    },
    {
      "start": 74.85471875,
      "end": 79.73159375,
      "speaker": "Customer",
      "text": "ஓகே நீங்க என்னென்ன கேட்டுட்டு எனக்கு கூப்பறீங்களா லைக் உங்க ஓன் பிரதருங்களா இல்லை ரிலேட்டிவ்ங்களாப்பா"
    },
    {
      "start": 80.44034375000001,
      "end": 81.72284375000001,
      "speaker": "Agent",
      "text": "இல்ல ஊன் பிரதுதான்"
    },
    {
      "start": 81.80721875,
      "end": 84.38909375,
      "speaker": "Customer",
      "text": "ஓகே நீங்கள் என்னென்னு என்ு கேட்டு கால் பேக் பண்ணுறீங்களா"
    },
    {
      "start": 84.96284375,
      "end": 86.26221875,
      "speaker": "Agent",
      "text": "ஆஹ் சரி ஓகே"
    },
    {
      "start": 85.82346875,
      "end": 87.29159375,
      "speaker": "Customer",
      "text": "ஆ ஓகே கேப்பா தேங்க்யூ"
    },
    {
      "start": 87.29159375,
      "end": 88.00034375,
      "speaker": "Agent",
      "text": "ரிங்க்யூ"
    },
    {
      "start": 90.41346875,
      "end": 90.97034375000001,
      "speaker": "Agent",
      "text": ""
    }
  ]
}