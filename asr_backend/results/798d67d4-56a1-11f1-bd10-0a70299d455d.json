    },
    {
      "start": 21.344093750000003,
      "end": 29.140343750000003,
      "speaker": "SPEAKER_00",
      "text": "ஓகே ஓகே எதனால் ப்ப்போம் இன்கேஸ் நீட் படிச்சாலுேது உளுக்குக்கப்லாம் இருக்கணும் இலைங்களாதுக்கப்புறம் இந்த நீட படிக்க போிறீங்களா ஆல்ரெடி படிச்ச வச்சுருக்கீங்களா"
    },
    {
      "start": 30.59159375,
      "end": 32.19471875,
      "speaker": "SPEAKER_01",
      "text": "ம் நெக்ஸ்ட் இயர் கதான்"
    },
    {
      "start": 32.63346875,
      "end": 34.30409375,
      "speaker": "SPEAKER_00",
      "text": "நெஸ்ட் இர் எழுதுான் பளான் பண்ணிருக்கீங்க"
    },
    {
      "start": 34.69221875,
      "end": 35.502218750000004,
      "speaker": "SPEAKER_01",
      "text": "உம் ஆமா"
    },
    {
      "start": 34.81034375,
      "end": 40.17659375,
      "speaker": "SPEAKER_00",
      "text": "ஆமா ஓகே என்ன திடீர்னு நீட்டுின்ு சொல்றதுக்கு ரீசன் என்ன சார் தெரிஞ்சுக்கலாங்க"
    },
    {
      "start": 40.969718750000006,
      "end": 43.838468750000004,
      "speaker": "SPEAKER_01",
      "text": "அது வந்து முன்னாடியே அப்படிதான் பிளான் பண்ணிருந்தும்"
    },
    {
      "start": 43.95659375,
      "end": 44.49659375,
      "speaker": "SPEAKER_00",
      "text": "ஓகே"
    },
    {
      "start": 44.73284375,
      "end": 49.76159375,
      "speaker": "SPEAKER_01",
      "text": "பட் ஆனா ஒன் ஒன் இயர் வந்து நமக்கு வந்து டைம் வந்து வேஸ்ட் ஆகிடக்கூடாது அது எடின்னு"
    },
    {
      "start": 50.18346875,
      "end": 53.81159375,
      "speaker": "SPEAKER_01",
      "text": "வீட்ல வந்து இன்ஜினியரிங் ஏதா பாக்கலாம் அப்படின்னு சொல்லி பாாரத்தாங்க"
    },
    {
      "start": 53.963468750000004,
      "end": 54.65534375,
      "speaker": "SPEAKER_00",
      "text": "ம் ம் ம்"
    },
    {
      "start": 55.38096875,
      "end": 58.03034375,
      "speaker": "SPEAKER_01",
      "text": "அதுக்கடுத்து வந்து அது வந்து நம்ம வந்து"
    },
    {
      "start": 58.53659375,
      "end": 59.04284375,
      "speaker": "SPEAKER_01",
      "text": "உம்"
    },
    {
      "start": 59.48159375,
      "end": 61.05096875,
      "speaker": "SPEAKER_01",
      "text": "ஒண்ணு வந்து"
    },
    {
      "start": 61.135343750000004,
      "end": 65.37096875,
      "speaker": "SPEAKER_01",
      "text": "பக்கத்துலாம் திருநெல்வேலி சரவுண்ட் வந்து இ அவ்வளோ நல்ல காலேஜ் எல்லாம் இல்ல"
    },
    {
      "start": 65.75909375,
      "end": 71.47971875,
      "speaker": "SPEAKER_01",
      "text": "ம்ம் அதனால வந்து வெளியே போனும்னா வந்து அீஸ் த்ரீ லேக்ஸ் த்ரீ அண்ட் ஸ் எல்லாம் கோங்க"
    },
    {
      "start": 66.46784375,
      "end": 66.58596875,
      "speaker": "SPEAKER_00",
      "text": "ஆ"
    },
    {
      "start": 71.69909375,
      "end": 72.22221875000001,
      "speaker": "SPEAKER_01",
      "text": "ம் ம்"
    },
    {
      "start": 72.82971875,
      "end": 75.02346875,
      "speaker": "SPEAKER_01",
      "text": "அதனாலா நெக்ஸ்ட் இயர் நீட்டு படிச்சு பா"
    },
    {
      "start": 75.02346875,
      "end": 81.18284375,
      "speaker": "SPEAKER_00",
      "text": "ப்ப பாஸ் பண்ணலாம்க்சுவலா பாி ந நீ நெக்ஸ்ட் இயர் எழு பாஸ் பண்ணலாம் அப்படின்னு நினைக்கிறீங்க"
    },
    {
      "start": 81.31784375000001,
      "end": 85.04721875,
      "speaker": "SPEAKER_00",
      "text": "ஆனா நீ் வ பாத்தங்கன்னா ஒரு வருஷத்துக்கு டுவெண்டிஃபைவ்லக்ஸ் ஸ்டூட்ஸ் இருக்கறாங்க"
    },
    {
      "start": 81.62159375,
      "end": 82.24596875,
      "speaker": "SPEAKER_01",
      "text": "ஆ ஆ"
    },
    {
      "start": 85.50284375000001,
      "end": 91.83096875000001,
      "speaker": "SPEAKER_00",
      "text": "ெகீத்தன்லேீட் கிடைக்குதுரெகா"
    },
    {
      "start": 85.77284375,
      "end": 86.38034375000001,
      "speaker": "SPEAKER_01",
      "text": "ஆ"
    },
    {
      "start": 86.83596875,
      "end": 87.44346875000001,
      "speaker": "SPEAKER_01",
      "text": ""
    },
    {
      "start": 92.25284375000001,
      "end": 110.61284375000001,
      "speaker": "SPEAKER_00",
      "text": "அது அதுலயுமே வந்து பாீங்கா உளுக்கு ஹையஸ்டான கட் ஆஃப் வேணும்ஹ நம் நைக்கிறோம் ஆனது குய்ஈஸி இல்ல அ அததான் வந்து பாாரீங்கன்னாரியாலிட்டி நிறைய ஸ்டூடெண்ட்ஸ்க்கு இப்போ இ்கேஸ் நீங்க ஒரு நல்ல கட் ஆப்ல எாம் நீ பாஸ் பண்ணலனா கூ மினிமமா வந்து பா்த்தீங்கன்னா நீங்க இருபதுல இருந்து இருபத்தஞ்சு லட்சம் ரூபா கொடுத்தா மட்டும் தான் படிக்க முடியும் சாரி டாக்டருங்கிற ஒரு விஷயத்த படிக்க முடியும்"
    },
    {
      "start": 92.96159375,
      "end": 93.18096875,
      "speaker": "SPEAKER_01",
      "text": ""
    },
    {
      "start": 99.91409375,
      "end": 100.38659375,
      "speaker": "SPEAKER_01",
      "text": "உம்"
    },
    {
      "start": 104.08221875000001,
      "end": 104.52096875000001,
      "speaker": "SPEAKER_01",
      "text": ""
    },
    {
      "start": 111.11909375,
      "end": 121.49721875,
      "speaker": "SPEAKER_00",
      "text": "அதுக்கப்புறம் நீங்க ட்டர் முடிச்சு நீங்க மாஸ்டர் சர்ஜன் ஒரு விஷயத்து ரெண்டு வருஷ முடிச்சு இது மொத்தத்துலயே முடிச்சா மட்டும்தான் பத்து வருஷம் நீங்க டிரராவல் பண்ணா மாட்டும்ட்டர்ங்க வர முடியும்"
    },
    {
      "start": 121.95284375000001,
      "end": 123.47159375000001,
      "speaker": "SPEAKER_00",
      "text": "பட் இன்ஜினியரிங் அப்படிங்கிறது"
    },
    {
      "start": 123.87659375000001,
      "end": 129.20909375,
      "speaker": "SPEAKER_00",
      "text": "ஒரு ஃபோர்யர்ஸ்லே வந்துத்தீங்கன்னாங்களால அகக்குள்ளான சேலரிங்கிறதுத உங்களால ரீச் பண்ற அளவு வ ப பாத்தங்கன்னா இருக்க கூடிய இப்போ"
    },
    {
      "start": 129.81659375,
      "end": 131.62221875,
      "speaker": "SPEAKER_00",
      "text": "ங்க சார்ஜிட் சர்ச் பண்ணீங்காலும் தெரியும்"
    },
    {
      "start": 132.11159375,
      "end": 132.68534375000002,
      "speaker": "SPEAKER_00",
      "text": "உங்களுக்கு"
    },
    {
      "start": 132.78659375,
      "end": 137.61284375,
      "speaker": "SPEAKER_00",
      "text": "டெக்ல வண்டா வந்து பாத்தீங்கா இப்ப மெடிச்க வந்து பா டெக்லண்டான் சேரி ஹங்கிறதுக்கு"
    },
    {
      "start": 137.93346875,
      "end": 138.42284375,
      "speaker": "SPEAKER_00",
      "text": "உம்"
    },
    {
      "start": 138.42284375,
      "end": 141.22409375,
      "speaker": "SPEAKER_01",
      "text": "சரி அது ஓகே சார் பத்தானா"
    },
    {
      "start": 141.79784375,
      "end": 144.51471875000001,
      "speaker": "SPEAKER_01",
      "text": "வீட்ல வந்து சரி அதுவும் பிக்ஸ் பண்ணப்பாங்க"
    },
    {
      "start": 144.63284375,
      "end": 145.30784375000002,
      "speaker": "SPEAKER_01",
      "text": "ம் ம் ம்"
    },
    {
      "start": 146.35409375,
      "end": 147.36659375000002,
      "speaker": "SPEAKER_01",
      "text": "ம் அ"
    },
    {
      "start": 147.68721875,
      "end": 149.32409375,
      "speaker": "SPEAKER_01",
      "text": "ஒன் எம்ிஎஸ் எம்ிபிஎஸ்"
    },
    {
      "start": 149.57721875000001,
      "end": 152.95221875000001,
      "speaker": "SPEAKER_01",
      "text": "இல்லன்னா அதுக்கு கீழே வந்து நேச்சுரல் நேச்சுர பதி இல்ன்னா"
    },
    {
      "start": 149.77971875,
      "end": 149.84721875,
      "speaker": "SPEAKER_00",
      "text": ""
    },
    {
      "start": 153.27284375000002,
      "end": 155.68596875,
      "speaker": "SPEAKER_01",
      "text": "ஆஹ் சித்தா அந்த மாதிரி எதுனா ஒரு"
    },
    {
      "start": 156.02346875,
      "end": 157.89659375000002,
      "speaker": "SPEAKER_01",
      "text": "அது குறச்சள்ள கட்ட் ஆஃே இல்ல அது"
    },
    {
      "start": 158.20034375,
      "end": 162.35159375,
      "speaker": "SPEAKER_01",
      "text": "நமக்கு வழுந்து ஒரு சிக்ஸ் பிப்டியா அபவ் எடுத்துட்டேனா எம்பிபிஎஸ் கு நாலேஜ் கிடைக்கும்"
    },
    {
      "start": 161.87909375,
      "end": 161.96346875,
      "speaker": "SPEAKER_00",
      "text": ""
    },
    {
      "start": 162.35159375,
      "end": 163.14471875,
      "speaker": "SPEAKER_00",
      "text": "ஆமா ஆமா"
    },
    {
      "start": 163.06034375000002,
      "end": 169.67534375000002,
      "speaker": "SPEAKER_01",
      "text": "இல்லன்னா நமக்கு வந்து அதுக்குஞ்ச கிட்ட இரு ஒருைவ் சிக்ஸ் ஹண்ட்ரட் இல்லைன்னா பைவ் பிப்டி கிட்ட இருக்கு அந்த இதுக்குள்ள இருக்குன்னா நம்ம வந்து"
    },
    {
      "start": 164.62971875000002,
      "end": 166.62096875,
      "speaker": "SPEAKER_00",
      "text": "ஞ ஒருிக"
    },
    {
      "start": 169.89471875,
      "end": 174.33284375000002,
      "speaker": "SPEAKER_01",
      "text": "அதுல எம்பிபிஎஸ் எடுக்கலாம் பட் ஆனா பிரைவேட்ல கிடைக்கும் இல்ன்னா நமக்கு வந்து நம்ம"
    },
    {
      "start": 175.21034375000002,
      "end": 178.83846875,
      "speaker": "SPEAKER_01",
      "text": "தான் அந்த மாதிரி வேற ஏதாவதுெல்லாம் எடுத்துக்கலாம் அதுவும் ஓரளவு நல்லா"
    },
    {
      "start": 176.67846875,
      "end": 177.57284375,
      "speaker": "SPEAKER_00",
      "text": "எடுத்துக்கோம்"
    },
    {
      "start": 178.83846875,
      "end": 179.36159375,
      "speaker": "SPEAKER_00",
      "text": "ம் அப்படி"
    },
    {
      "start": 178.88909375,
      "end": 180.23909375000002,
      "speaker": "SPEAKER_01",
      "text": "அப்படிதான் வீட்டுல சொல்லுங்க"
    },
    {
      "start": 180.59346875,
      "end": 180.86346875,
      "speaker": "SPEAKER_00",
      "text": ""
    },
    {
      "start": 180.86346875,
      "end": 181.36971875,
      "speaker": "SPEAKER_01",
      "text": "ஆல"
    },
    {
      "start": 180.89721875,
      "end": 184.74471875,
      "speaker": "SPEAKER_00",
      "text": "வீலந்து பாத்தீங்கா இப்ப மெடிசன் பீல்டுள்ளேயிடாம் அப்பங்க டிசன் எடுத்திருக்காங்க இல்லங்களா"
    },
    {
      "start": 184.74471875,
      "end": 185.72346875000002,
      "speaker": "SPEAKER_01",
      "text": "உம் ஆமா"
    },
    {
      "start": 186.04409375,
      "end": 186.76971875,
      "speaker": "SPEAKER_00",
      "text": ""
    },
    {
      "start": 186.11159375000003,
      "end": 189.87471875,
      "speaker": "SPEAKER_01",
      "text": "இ சிபிஎஸ்சன்றனால வந்து கொஞ்சம் பாஸ் பண்ணதுக்கும் கொஞ்சம் வாய்ப்பு இரு"
    },
    {
      "start": 189.87471875,
      "end": 190.19534375,
      "speaker": "SPEAKER_00",
      "text": "ச"
    },
    {
      "start": 190.92096875000001,
      "end": 191.78159375,
      "speaker": "SPEAKER_00",
      "text": "அது என்ன"
    },
    {
      "start": 190.98846875,
      "end": 194.26221875000002,
      "speaker": "SPEAKER_01",
      "text": "அப்படின்னா நிறைய பேர் வந்து கேட்டதுல சொல்றாங்க நிறைய பேரு இந்த மெட்ரிக்"
    },
    {
      "start": 193.03034375000001,
      "end": 195.52784375000002,
      "speaker": "SPEAKER_00",
      "text": "ங்க நிறைய பேர் அ ஒர்க் ஆகாது"
    },
    {
      "start": 195.91596875000002,
      "end": 201.63659375,
      "speaker": "SPEAKER_00",
      "text": "ஆ சி இருக்கிறதுனால் பாஸ் பண்ண அப்பனு நின சிபிஸ்ஸஸ் சூஸ்ண்ண எல்லாருமே பாஸ் பண்ணிருக்கணும் அடியே கிடையாது"
    },
    {
      "start": 196.23659375000003,
      "end": 196.96221875,
      "speaker": "SPEAKER_01",
      "text": "சரி சரி"
