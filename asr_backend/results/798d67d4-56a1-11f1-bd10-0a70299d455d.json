    {
      "start": 203.22284375,
      "end": 205.95659375000002,
      "speaker": "SPEAKER_01",
      "text": "படிக்கணும் சார் அது அது உண்டுதான்"
    },
    {
      "start": 206.46284375000002,
      "end": 208.21784375000001,
      "speaker": "SPEAKER_01",
      "text": "ஆ சொல் அது வந்து அவங்க"
    },
    {
      "start": 208.63971875000001,
      "end": 213.41534375,
      "speaker": "SPEAKER_01",
      "text": "வித் ஸ்டேட் போர்ட கம்பேர் பண்ணும்ோ கொஞ்சம் ஈஸியா அவங்க படிச்சுக்கிடுவாங்கன்றதுதான் நான் சொன்னுவேும்"
    },
    {
      "start": 212.84159375000002,
      "end": 214.41096875000002,
      "speaker": "SPEAKER_00",
      "text": "சொ பிர ச"
